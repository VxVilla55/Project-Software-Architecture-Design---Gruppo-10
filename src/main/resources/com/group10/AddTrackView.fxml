<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>


<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group10.controller.AddTrackController">
   <children>
      <VBox layoutX="100.0" layoutY="25.0" prefHeight="350.0" prefWidth="400.0" spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Aggiungi Traccia" />
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Titolo *" />
                  <Label text="Autore *" GridPane.rowIndex="1" />
                  <Label text="Durata (sec)" GridPane.rowIndex="2" />
                  <Label text="Genere" GridPane.rowIndex="3" />
                  <Label text="Anno" GridPane.rowIndex="4" />
                  <TextField fx:id="titleField" GridPane.columnIndex="1" />
                  <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="durationField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="genreField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            <Label fx:id="errorLabel" style="-fx-text-fill: red;;" visible="false" />
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" text="Salva" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Annulla" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
