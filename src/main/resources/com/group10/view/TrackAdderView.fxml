<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox layoutX="100.0" layoutY="25.0" prefHeight="350.0" prefWidth="400.0" spacing="10.0" 
            style="-fx-background-color: #1e1e1e; -fx-background-radius: 10; -fx-padding: 20; -fx-text-fill: white;">
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Aggiungi Traccia" />
            
            <GridPane style="-fx-text-fill: white;">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Label style="-fx-text-fill: white;" text="Titolo *" />
                  <Label style="-fx-text-fill: white;" text="Autore *" GridPane.rowIndex="1" />
                  <Label style="-fx-text-fill: white;" text="Durata (sec)" GridPane.rowIndex="2" />
                  <Label style="-fx-text-fill: white;" text="Genere" GridPane.rowIndex="3" />
                  <Label style="-fx-text-fill: white;" text="Anno" GridPane.rowIndex="4" />
                  
                  <TextField fx:id="titleField" GridPane.columnIndex="1" />
                  <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="durationField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="genreField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            
            <Label fx:id="errorLabel" style="-fx-text-fill: #ff6b6b;" visible="false" />
            
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="saveButton" onAction="#handleSave" text="Salva" />
                  <Button fx:id="cancelButton" onAction="#handleCancel" text="Annulla" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>