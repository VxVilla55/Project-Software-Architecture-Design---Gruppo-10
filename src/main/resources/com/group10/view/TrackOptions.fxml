<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" prefHeight="160.0" prefWidth="232.0" 
      style="-fx-background-color: #2A1200; -fx-border-color: #FF6B35; -fx-padding: 4; -fx-background-radius: 6; -fx-border-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(255,107,53,0.25), 10, 0, 0, 4);" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Button maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" 
              mnemonicParsing="false" onAction="#handleViewDetails" prefHeight="38.0" 
              style="-fx-background-color: transparent; -fx-text-fill: #FFF0E8; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 15 0 15; -fx-cursor: hand; -fx-background-radius: 4;" text="Visualizza dettaglio" />

      <Button maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" 
              mnemonicParsing="false" onAction="#handleAddToQueue" prefHeight="38.0" 
              style="-fx-background-color: transparent; -fx-text-fill: #FFF0E8; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 15 0 15; -fx-cursor: hand; -fx-background-radius: 4;" text="Aggiungi alla coda" />

      <Button maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" 
              mnemonicParsing="false" onAction="#handlePlayAsNext" prefHeight="38.0" 
              style="-fx-background-color: transparent; -fx-text-fill: #FFF0E8; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 15 0 15; -fx-cursor: hand; -fx-background-radius: 4;" text="Riproduci come prossimo" />

      <Button maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" 
              mnemonicParsing="false" onAction="#handleAddToPlaylist" prefHeight="38.0" 
              style="-fx-background-color: transparent; -fx-text-fill: #FF6B35; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 15 0 15; -fx-cursor: hand; -fx-background-radius: 4;" text="Aggiungi a playlist..." textOverrun="CLIP" />
   </children>
</VBox>
