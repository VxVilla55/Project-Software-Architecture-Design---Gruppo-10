<Button fx:id="removeTrackButton" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleRemoveTrack" prefHeight="38.0" style="-fx-background-color: transparent; -fx-text-fill: #37474F; -fx-font-weight: bold; -fx-alignment: center-left; -fx-padding: 0 15 0 15; -fx-cursor: hand; -fx-background-radius: 4;" text="Elimina Traccia" />   </children>
