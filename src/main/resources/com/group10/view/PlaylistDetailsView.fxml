<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" style="-fx-background-color: #FFF8E1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <HBox alignment="BOTTOM_LEFT" prefHeight="180.0" spacing="20.0" style="-fx-background-color: linear-gradient(to bottom, #EFE6CC, #FFF8E1);">
               <children>
                  <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="130.0" prefWidth="130.0" style="-fx-background-color: #D7CCC8; -fx-background-radius: 4; -fx-effect: dropshadow(three-pass-box, rgba(55,71,79,0.1), 10, 0, 0, 0);">
                     <children>
                        <ImageView fx:id="playlistImageView" fitHeight="130.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                     </children>
                  </AnchorPane>
                  
                  <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #78909C;" text="PLAYLIST" textFill="#78909C">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label fx:id="playlistNameLabel" style="-fx-text-fill: #37474F;" text="Nome della Playlist" textFill="#37474F">
                           <font>
                              <Font name="System Bold" size="38.0" />
                           </font>
                        </Label>
                        <Label fx:id="playlistTracksCountLabel" style="-fx-text-fill: #78909C;" text="0 brani" textFill="#78909C">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="5.0" />
                     </padding>
                  </VBox>
                  <Button fx:id="playlistPlayButton" layoutX="506.0" layoutY="95.0" minHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#handlePlayPausePlaylist" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #00BFA5; -fx-text-fill: #37474F; -fx-background-radius: 25; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 42; -fx-pref-height: 42;" AnchorPane.topAnchor="60.0">
                     <HBox.margin>
                        <Insets bottom="25.0" left="10.0" right="20.0" />
                     </HBox.margin>
                     <graphic>
                        <ImageView fitHeight="25.0" fitWidth="27.0" opacity="0.7" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/icons/play-button.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>

               </children>
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" prefHeight="30.0" spacing="15.0" style="-fx-border-color: #EFE6CC; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label alignment="CENTER_LEFT" minWidth="30.0" prefWidth="30.0" style="-fx-text-fill: #78909C;" text="#">
                     <HBox.margin><Insets left="15.0" /></HBox.margin>
                     <font><Font size="12.0" /></font>
                  </Label>
                  <Region minWidth="40.0" prefWidth="40.0" />
                  <!-- TITOLO: unica colonna flessibile, come nei TrackItem -->
                  <Label maxWidth="1.7976931348623157E308" minWidth="80.0" prefWidth="200.0" style="-fx-text-fill: #78909C;" text="TITOLO" HBox.hgrow="ALWAYS">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <Label alignment="CENTER_RIGHT" minWidth="100.0" prefWidth="100.0" style="-fx-text-fill: #78909C;" text="TAG">
                     <font><Font size="12.0" /></font>
                     <HBox.margin><Insets right="20.0" /></HBox.margin>
                  </Label>
                  <Label minWidth="80.0" prefWidth="80.0" style="-fx-text-fill: #78909C;" text="GENERE">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <Label alignment="CENTER" minWidth="50.0" prefWidth="50.0" style="-fx-text-fill: #78909C;" text="ANNO">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <Label alignment="CENTER_RIGHT" minWidth="60.0" prefWidth="60.0" style="-fx-text-fill: #78909C;" text="DURATA">
                     <font><Font size="12.0" /></font>
                  </Label>
                  <!-- spazio del pulsante menu nei TrackItem -->
                  <Region minWidth="30.0" prefWidth="30.0">
                     <HBox.margin><Insets right="15.0" /></HBox.margin>
                  </Region>
               </children>
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" />
               </padding>
            </HBox>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="tracksContainer" spacing="6.0" style="-fx-background-color: transparent;">
                     <padding>
                        <Insets left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
            
         </children>
      </VBox>
   </children>
</AnchorPane>
