<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="201.0" prefWidth="1065.0" 
            style="-fx-background-color: #121212;" 
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
<Slider fx:id="trackSlider" 
        layoutX="313.0" layoutY="43.0" 
        prefHeight="18.0" prefWidth="440.0" 
        min="0" max="100" 
        style="-fx-control-inner-background: #282828; -fx-accent: #1DB954; -fx-cursor: hand;" />
      
      <Button layoutX="831.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleFavorite" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-font-size: 14px; -fx-cursor: hand;" text="❤️" />
      
      <Button layoutX="972.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleRepeat" style="-fx-background-color: #282828; -fx-text-fill: #b3b3b3; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="REPEAT" />
      <Button layoutX="882.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleShuffle" style="-fx-background-color: #282828; -fx-text-fill: #b3b3b3; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="SHUFFLE" />
      <Button layoutX="640.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleNextPlaylist" style="-fx-background-color: #282828; -fx-text-fill: #b3b3b3; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="NEXT_PLAYLIST" />
      
      <Button layoutX="437.0" layoutY="95.0" mnemonicParsing="false" onAction="#handlePrevious" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="⏮️" />
      <Button layoutX="575.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleNext" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" text="⏭️" />
      
<Button fx:id="playPauseButton" layoutX="506.0" layoutY="95.0" 
        mnemonicParsing="false" onAction="#handlePlayPause" 
        style="-fx-background-color: #ffffff; -fx-text-fill: #000000; 
               -fx-background-radius: 25; -fx-font-size: 20px; 
               -fx-font-weight: bold; -fx-cursor: hand; 
               -fx-pref-width: 50; -fx-pref-height: 50;" 
        text="▶" />      
      <Label fx:id="trackTitle" layoutX="79.0" layoutY="74.0" prefHeight="31.0" prefWidth="150.0" style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px;" text="Titolo" />
      <Label fx:id="trackAuthor" layoutX="79.0" layoutY="116.0" prefHeight="21.0" prefWidth="150.0" style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px;" text="Autore" />
   </children>
</AnchorPane>