<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="260.0" style="-fx-background-color: #0F0500;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="550.0" prefWidth="260.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <Label text="Dettaglio brano" textFill="#C4906B">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>

            <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="180.0" prefWidth="180.0" style="-fx-background-color: #2A1200; -fx-background-radius: 8;">
               <children>
                  <ImageView fx:id="trackImageView" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </AnchorPane>

            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label fx:id="titleLabel" alignment="CENTER" maxWidth="220.0" text="Titolo della Traccia" textAlignment="CENTER" textFill="#FFF0E8" wrapText="true">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="artistLabel" alignment="CENTER" maxWidth="220.0" text="Nome Autore" textAlignment="CENTER" textFill="#FF6B35" wrapText="true">
                     <font>
                        <Font name="System System" size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <Label text="Informazioni Brano" textFill="#C4906B">
               <font>
                  <Font size="11.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>

            <VBox maxWidth="220.0" spacing="12.0" style="-fx-background-color: #2A1200; -fx-background-radius: 8;">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label text="GENERE" textFill="#C4906B">
                           <font><Font name="System Bold" size="9.0" /></font>
                        </Label>
                        <Label fx:id="genreLabel" text="Rock / Pop" textFill="#FFF0E8">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="2.0">
                     <children>
                        <Label text="ANNO DI PUBBLICAZIONE" textFill="#C4906B">
                           <font><Font name="System Bold" size="9.0" /></font>
                        </Label>
                        <Label fx:id="yearLabel" text="1975" textFill="#FFF0E8">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="2.0">
                     <children>
                        <Label text="DURATA" textFill="#C4906B">
                           <font><Font name="System Bold" size="9.0" /></font>
                        </Label>
                        <Label fx:id="durationLabel" text="05:55" textFill="#FFF0E8">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
            </VBox>

            <Button fx:id="deleteButton" maxWidth="220.0" mnemonicParsing="false" onAction="#handleDelete"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4906B; -fx-border-color: #3A1E00; -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="🗑 Elimina traccia">
               <font><Font size="13.0" /></font>
               <VBox.margin><Insets bottom="15.0" top="5.0" /></VBox.margin>
            </Button>

         </children>
         <padding>
            <Insets left="15.0" right="15.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
