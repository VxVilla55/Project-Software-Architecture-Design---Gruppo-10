<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="700.0" style="-fx-background-color: #1A0A00;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group10.controller.HomepageController">
   <children>
      
      <Label style="-fx-text-fill: #FFF0E8; -fx-font-weight: bold;" text="Le tue playlist preferite">
         <font><Font size="20.0" /></font>
         <VBox.margin><Insets bottom="10.0" left="20.0" top="20.0" /></VBox.margin>
      </Label>
      <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="NEVER">
         <content>
            <HBox fx:id="playlistsCardsContainer" spacing="15.0" style="-fx-background-color: transparent;">
               <padding><Insets bottom="10.0" left="20.0" right="20.0" top="5.0" /></padding>
            </HBox>
         </content>
      </ScrollPane>

      <Label style="-fx-text-fill: #FFF0E8; -fx-font-weight: bold;" text="I tuoi brani consigliati">
         <font><Font size="20.0" /></font>
         <VBox.margin><Insets bottom="10.0" left="20.0" top="25.0" /></VBox.margin>
      </Label>
      <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="NEVER">
         <content>
            <HBox fx:id="tracksCardsContainer" spacing="15.0" style="-fx-background-color: transparent;">
               <padding><Insets bottom="10.0" left="20.0" right="20.0" top="5.0" /></padding>
            </HBox>
         </content>
      </ScrollPane>

   </children>
</VBox>
