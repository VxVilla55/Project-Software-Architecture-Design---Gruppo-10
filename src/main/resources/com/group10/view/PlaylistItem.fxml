<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="root" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minHeight="-Infinity" onMouseClicked="#handleSelection" prefHeight="60.0" spacing="12.0" style="-fx-background-color: #FFF8E1; -fx-background-radius: 6; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="42.0" prefWidth="42.0" style="-fx-background-color: #D7CCC8; -fx-background-radius: 4;">
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
         <children>
            <ImageView fx:id="coverImage" fitHeight="42.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
      </AnchorPane>

      <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="nameLabel" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #37474F;" text="Nome Playlist" />
            <Label fx:id="trackCountLabel" style="-fx-text-fill: #78909C; -fx-font-size: 12px;" text="0 brani" />
         </children>
      </VBox>

      <Button fx:id="playlistMenuButton" mnemonicParsing="false" onAction="#handleOptions" style="-fx-background-color: transparent; -fx-text-fill: #78909C; -fx-font-size: 14px; -fx-cursor: hand;" text="⋮">
         <HBox.margin>
            <Insets right="15.0" />
         </HBox.margin>
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>

   </children>
</HBox>
