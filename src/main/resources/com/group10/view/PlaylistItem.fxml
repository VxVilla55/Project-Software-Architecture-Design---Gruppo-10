<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="root" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="60.0" spacing="12.0"
      style="-fx-background-color: #ffffff; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0; -fx-cursor: hand;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <!-- Copertina: quadrato con sfondo colorato e nota musicale -->
      <StackPane prefHeight="42.0" prefWidth="42.0"
                 style="-fx-background-color: #1db954; -fx-background-radius: 6;">
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin>
         <children>
            <Text style="-fx-font-size: 22px;" text="♪" fill="white" />
         </children>
      </StackPane>

      <!-- Nome playlist -->
      <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="nameLabel"
                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #222222;"
                   text="Nome Playlist" />
            <Label fx:id="trackCountLabel"
                   style="-fx-text-fill: #777777; -fx-font-size: 12px;"
                   text="0 brani" />
         </children>
      </VBox>

      <!-- Pulsante menu contestuale -->
      <Button fx:id="playlistMenuButton" mnemonicParsing="false"
              style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 14px; -fx-cursor: hand;"
              text="⋮">
         <HBox.margin>
            <Insets right="10.0" />
         </HBox.margin>
      </Button>

   </children>
</HBox>
