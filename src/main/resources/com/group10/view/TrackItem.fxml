<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox fx:id="root" alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onMouseClicked="#handleSelection" prefHeight="55.0" prefWidth="650.0" spacing="15.0" style="-fx-background-color: #FFF8E1; -fx-background-radius: 6; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="indexLabel" alignment="CENTER" prefWidth="30.0" style="-fx-text-fill: #78909C;" text="1">
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
         <font>
            <Font name="System System" size="14.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="157.0" HBox.hgrow="SOMETIMES">
         <children>
            <Label fx:id="titleLabel" style="-fx-text-fill: #37474F; -fx-font-weight: bold;" text="Titolo della Traccia">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label fx:id="artistLabel" style="-fx-text-fill: #78909C;" text="Nome Artista">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
      
      <HBox fx:id="tagsContainer" alignment="CENTER_LEFT" spacing="5.0" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="favouriteLabel" alignment="CENTER" contentDisplay="CENTER" managed="false" maxHeight="21.0" maxWidth="21.0" minHeight="21.0" minWidth="21.0" prefHeight="21.0" prefWidth="21.0" style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-background-radius: 3; -fx-padding: 2 6 2 6; -fx-font-weight: bold; -fx-font-size: 10;" text="" visible="false">
               <graphic>
                  <ImageView fitHeight="13.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true" scaleX="0.9" scaleY="0.9">
                     <image>
                        <Image url="@../images/heart.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <Label fx:id="newReleaseLabel" managed="false" maxHeight="21.0" minHeight="21.0" prefHeight="21.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 3; -fx-padding: 2 6 2 6; -fx-font-weight: bold; -fx-font-size: 12;" text="NEW" visible="false" />
            <Label fx:id="explicitLabel" managed="false" maxHeight="21.0" maxWidth="21.0" minHeight="21.0" minWidth="21.0" prefHeight="21.0" prefWidth="21.0" style="-fx-background-color: #FFB300; -fx-text-fill: white; -fx-background-radius: 3; -fx-padding: 2 6 2 6; -fx-font-weight: bold; -fx-font-size: 12;" text="E" visible="false" />
         </children>
      </HBox>
      
      <Label fx:id="genreLabel" prefWidth="100.0" style="-fx-text-fill: #78909C;" text="Rock">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      
      <Label fx:id="yearLabel" alignment="CENTER" prefWidth="50.0" style="-fx-text-fill: #78909C;" text="1975">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      
      <Label fx:id="durationLabel" alignment="CENTER_RIGHT" prefWidth="60.0" style="-fx-text-fill: #78909C;" text="05:55">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      
      <Button fx:id="trackMenuButton" mnemonicParsing="false" onAction="#handleOptions" style="-fx-background-color: transparent; -fx-text-fill: #78909C; -fx-cursor: hand;" text="⋮">
         <HBox.margin>
            <Insets right="15.0" />
         </HBox.margin>
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="5.0" top="5.0" />
   </padding>
</HBox>
